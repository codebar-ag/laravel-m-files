{
    "name": "codebar-ag/laravel-m-files",
    "description": "M-Files integration with Laravel",
    "keywords": [
        "laravel",
        "m-files",
        "codebar-ag",
        "laravel-m-files",
        "codebar Solutions AG",
        "M-Files"
    ],
    "homepage": "https://github.com/codebar-ag/laravel-m-files",
    "license": "MIT",
    "authors": [
        {
            "name": "Sebastian Bürgin-Fix",
            "email": "helpdesk@codebar.ch",
            "homepage": "https://www.codebar.ch",
            "role": "Software-Engineer"
        }
    ],
    "require": {
        "php": "8.3.*|8.4.*|8.5.*",
        "guzzlehttp/guzzle": "^7.9.2",
        "illuminate/contracts": "^13.0",
        "illuminate/support": "^13.0",
        "saloonphp/cache-plugin": "^3.1",
        "saloonphp/laravel-plugin": "^4.0",
        "saloonphp/saloon": "^4.0",
        "spatie/laravel-package-tools": "^1.19.0"
    },
    "require-dev": {
        "laravel/pint": "^1.30.4",
        "larastan/larastan": "^3.10",
        "nunomaduro/collision": "^8.9.5",
        "orchestra/testbench": "^11.1",
        "pestphp/pest": "^4.7.8|^5.0",
        "phpdocumentor/reflection-docblock": "^5.6.1|^6.0",
        "phpstan/extension-installer": "^1.4.3",
        "phpstan/phpstan-deprecation-rules": "^2.0.5",
        "phpstan/phpstan-phpunit": "^2.0.18",
        "spatie/laravel-ray": "^1.43.9"
    },
    "autoload": {
        "psr-4": {
            "CodebarAg\\MFiles\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "CodebarAg\\MFiles\\Tests\\": "tests"
        }
    },
    "scripts": {
        "post-autoload-dump": "@php ./vendor/bin/testbench package:discover --ansi",
        "analyse": "vendor/bin/phpstan analyse",
        "larastan": "vendor/bin/phpstan analyse",
        "test": "vendor/bin/pest --no-coverage",
        "test-coverage": "vendor/bin/pest --coverage",
        "format": "vendor/bin/pint"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "composer/package-versions-deprecated": false,
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "CodebarAg\\MFiles\\MFilesServiceProvider"
            ]
        }
    },
    "prefer-stable": true
}
